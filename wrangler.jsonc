{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "small-shop-web",
  "compatibility_date": "2026-10-01",
  // Claude API gateway (/api/ai/*, /api/admin/*). Every other path is the static site.
  "main": "worker/index.js",
  // Usage database for Small Shop Web keys (README, "Claude API para clientes").
  "d1_databases": [{ "binding": "DB", "database_name": "small-shop-web-ai", "database_id": "14ff717b-bf33-400d-9445-0e4cbe654ef0" }],
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  }
}
